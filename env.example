# Next.js 환경 변수
# 로컬 개발 시: http://localhost:3000
# Vercel 배포 시: https://somy2kreadingnote.vercel.app
NEXT_PUBLIC_BASE_URL=https://somy2kreadingnote.vercel.app

# Vercel 배포 시 자동으로 설정됨 (NEXT_PUBLIC_BASE_URL이 없을 때 사용)
# VERCEL_URL=somy2kreadingnote.vercel.app

# 개발 환경
NODE_ENV=development

# 카카오 REST API 키 (필수)
# https://developers.kakao.com 에서 앱 생성 후 발급
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 이미지 재호스팅 (2차 안정화 - Vercel Blob)
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=your_vercel_blob_rw_token

# 이미지 저장/가져오기 보호 설정 (선택)
IMAGE_FETCH_TIMEOUT_MS=15000
IMAGE_STORAGE_MAX_BYTES=10485760
